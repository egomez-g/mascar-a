textoIntro = Array[String](["Dialogo intro: P-p-perdona joven… Ne-necesito tu ayuda", "he escuchado q-q-que partes cosas", "y la enfermera me sigue d-d-dando las pastillas de siempre.", "¿Podrías ayudarme? t-tengo dinero."])
