[resource]
script = ExtResource("7_ydbi2")
textoIntro = Array[String](["Escucha, no tengo mucho tiempo", "Ellos saben que he despertado, dale una vuelta", "Esa paloma de ahí... es un dron biológico", "Te pagaré el doble, pero tienes que deshacerte de ella, antes de que… vengan mas"])
textoPostMascar = Array[String](["No sabes de la que me has salvado", "tengo un bunker", "tiene las puertas abiertas para ti, lo necesitarás pronto"])
textoPostThrash = Array[String](["¡Para! ¡Así sabrán donde estamos!", "Tengo que huir de aquí ahora"])
mascarData = SubResource("Resource_v1qok")
